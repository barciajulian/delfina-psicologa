---
import { WHATSAPP_URL, INSTAGRAM_URL, EMAIL } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/como-trabajo', label: 'Cómo trabajo' },
  { href: '/consulta', label: 'Consultá' },
];
const current = (href: string) => path === href || path === href + '/';
---
<header class="nav">
  <div class="nav__bar">
    <a class="nav__wordmark" href="/">Delfina Martínez</a>
    <div class="nav__right">
      <nav class="nav__links" aria-label="Navegación principal">
        {links.map((l) => (
          <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <span class="nav__sep" aria-hidden="true"></span>
      <div class="nav__social">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.73 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.28.86 5.84 2.42a8.2 8.2 0 0 1 2.42 5.84c0 4.55-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.25-8.24m4.7 10.24c-.26-.13-1.52-.75-1.76-.83-.24-.09-.41-.13-.58.13s-.67.83-.82 1c-.15.18-.3.2-.56.07-.26-.13-1.09-.4-2.07-1.28-.77-.68-1.28-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.12-.12.26-.3.39-.46.13-.15.17-.26.26-.44.09-.18.04-.33-.02-.46-.07-.13-.58-1.4-.8-1.92-.21-.5-.42-.43-.58-.44l-.5-.01c-.17 0-.44.07-.67.33-.23.26-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.6.13.18 1.77 2.7 4.3 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.52-.62 1.73-1.22.21-.6.21-1.11.15-1.22-.06-.11-.24-.18-.5-.31"></path></svg>
        </a>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"></path><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17" cy="7" r="1" fill="currentColor"></circle></svg>
        </a>
        <a href={`mailto:${EMAIL}`} aria-label="Email">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><path fill="none" stroke="currentColor" stroke-width="1.8" d="m4 7 8 6 8-6"></path></svg>
        </a>
      </div>
    </div>
  </div>
</header>
